// STACK DATA STRUCTURE
#include<stdio.h>
# define size 5
int stack[size];
int top=-1;
void push(int item);
void pop();
void display();
int main(){
int choice,item;
while(1){
    printf("\n----STACK MENU----\n");
    printf("1.push\n");
    printf("2.pop\n");
    printf("3.display\n");
    printf("4.exit\n");
    printf("Enter your choice\n");
    scanf("%d",&choice);
    switch(choice){
        case 1:
        printf("Enter element to insert\n");
        scanf("%d",&item);
        push(item);
        break;
        case 2:
        pop();
        break;
        case 3:
        display();
        break;
        case 4:
        printf("Exiting program\n");
        return 0;
        default:
        printf("Invaid choice");
    } 
}}
void push(int item){
    if(top==size-1){
        printf("\nStack is full or overflow\n");   
    }
    else{
        top++;
        stack[top]=item;
    }
}
void pop(){
    if(top==-1){
        printf("Stack is empty or underflow\n");
    }
    else{
        printf("\nDeleted item is %d\n",stack[top]);
        top--;
    }
}
void display(){
    if(top==-1){
        printf("Stack is empty\n");
        
    }
    else{
        for(int i=0;i<=top;i++){
            printf("%d ",stack[i]);
        }
    }
}
